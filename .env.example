NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: ingest routes, exports and admin jobs. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Bearer token n8n sends to /api/ingest/*; a fresh value per environment.
INGEST_TOKEN=
CENSUS_API_KEY=
SIMPLER_GRANTS_API_KEY=
# Optional: raises Socrata (CDC PLACES, VA VetPop) rate limits.
SOCRATA_APP_TOKEN=
INGEST_ALERT_WEBHOOK_URL=
INGEST_ALERT_GITHUB_TOKEN=
INGEST_ALERT_GITHUB_REPO=
# Shared secret the n8n alert webhook checks (x-fas-alert-secret).
INGEST_ALERT_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_RPM_LIMIT=18
OPENROUTER_DAILY_LIMIT=45
# F-508i bake-off only (`pnpm eval:llm` sets it): allows forceProvider. Never set it in Vercel or the app.
LLM_EVAL=
