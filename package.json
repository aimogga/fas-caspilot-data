{
  "name": "fas-casepilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "node scripts/test-db.mjs",
    "audit:nightly": "node scripts/nightly-audit.mjs",
    "gate": "node scripts/pr-gate.mjs",
    "shots": "node scripts/design-shots.mjs",
    "review-page": "node scripts/design-review-page.mjs",
    "test:e2e": "playwright test",
    "seed:synthetic": "node --experimental-strip-types --no-warnings=ExperimentalWarning lib/synthetic/cli.ts",
    "eval:grants": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/grant-match-eval.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.4.0",
    "docx": "^9.11.0",
    "lucide-react": "1.55.0",
    "next": "16.4.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "read-excel-file": "9.3.12",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "fflate": "0.8.3",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "^5",
    "us-atlas": "^3.0.1",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@10.33.3"
